# Local PostgreSQL + PostGIS container
POSTGRES_USER=headway
POSTGRES_PASSWORD=headway_dev
POSTGRES_DB=headway
POSTGRES_PORT=5432

# API database access
DATABASE_URL=postgres://headway:headway_dev@127.0.0.1:5432/headway

# API listener
HOST=127.0.0.1
PORT=3001

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional frontend build-time API origin. Leave unset when a reverse proxy
# serves the frontend and API on one origin. Do not include an /api path.
# VITE_API_BASE_URL=https://api.example.com

# TTC vehicle collector remains disabled unless explicitly enabled.
TTC_VEHICLE_COLLECTOR_ENABLED=false
TTC_VEHICLE_POLL_INTERVAL_SECONDS=60
TTC_VEHICLE_STALE_AFTER_SECONDS=180
TTC_VEHICLE_RETENTION_HOURS=6
